---
import directus from "../lib/directus";
import { readItems } from '@directus/sdk';
const mainNavigation = await directus.request(readItems('main_navigation', {
    filter: { status: { _eq: 'published' } }
}));
console.log(mainNavigation);
---
<header class="glass">
    <div class="container">
        <nav>
            <ul>
                <li><strong>Wanderwetter</strong></li>
            </ul>
            <ul>
                {mainNavigation.map (item => (
                        <li><a href={item.url} class="contrast"  target={item.external ? '_blank' : undefined}  rel={item.external ? 'noopener noreferrer' : undefined}>{item.title}</a></li>
                ))}
            </ul>
        </nav>
    </div>
</header>

<style>
    header {
        max-width: unset;
        padding: 0;
        position: sticky;
        top: 0;
    }
</style>